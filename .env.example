APP_NAME="Trazabilidad de estibas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trazabilidad
DB_USERNAME=trazabilidad
DB_PASSWORD=
# Esquema de PostgreSQL; public si no se indica.
DB_SCHEMA=public

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SAP Business One. Only "fake" exists until the real environment is verified (DP-09).
SAP_DRIVER=fake
SAP_RECEIPT_WAREHOUSE=04
SAP_TRANSFER_FROM_WAREHOUSE=04
SAP_TRANSFER_TO_WAREHOUSE=05
SAP_ENVIRONMENT=DEV
SAP_API_URL_DEV=
SAP_COMPANY_DEV=
SAP_USER_DEV=
SAP_PASSWORD_DEV=
SAP_ORDER_ITEM_PREFIX=PT
SAP_BOX_GTIN_INDICATOR=1
SAP_RECEIPT_CORRELATION_FIELD=U_TRZ_UUID
SAP_RECEIPT_COSTING_CODE=PCC
SAP_RECEIPT_COSTING_CODE2=PRODUCCI
SAP_RECEIPT_COSTING_CODE3=ANTIOQUI
SAP_TRANSFER_CARD_CODE=P811022882
# Non-conforming warehouse: quality sends held pallets there from 04.
SAP_NON_CONFORMING_WAREHOUSE=11C
SAP_TRANSFER_DISTRIBUTION_RULE=PCC
SAP_TRANSFER_DISTRIBUTION_RULE2=PRODUCCI
SAP_TRANSFER_DISTRIBUTION_RULE3=ANTIOQUI
SAP_SL_VERIFY_TLS=true
SAP_SL_TIMEOUT=30
SAP_RESEND_AFTER_MINUTES=10
SAP_MAX_SEND_ATTEMPTS=3
SAP_STALE_SENDING_MINUTES=5
SAP_REQUEUE_AFTER_MINUTES=2
SAP_CHECK_EVERY_MINUTES=5

# Pending business decisions. Keep them off until approved.
TRACE_SCAN_INGESTION_ENABLED=false
TRACE_LABEL_CONFIRMATION=scan
TRACE_TEST_PALLET_BOXES=40
# DP-04: reaudit approved (a supervisor enables a new blind count).
TRACE_DISCREPANCY_REAUDIT_ENABLED=true
TRACE_DISCREPANCY_CLOSE_ACTIONS=
TRACE_COUNT_TIMEOUT_MINUTES=60
# Tries a blind count has before a discrepancy opens.
TRACE_COUNT_TRIES=3

PALLET_CODE_PREFIX=EST
PALLET_CODE_DIGITS=8
TRACE_SCAN_RATE_PER_MINUTE=300

# Printable label size until DP-07 defines printer and layout.
LABEL_WIDTH_MM=100
LABEL_HEIGHT_MM=150

VITE_APP_NAME="${APP_NAME}"

# Alertas operativas (ops:check, /operations, /api/health). Ver config/operations.php.
OPS_NOTIFY_COOLDOWN_MINUTES=60
OPS_REJECTED_SCANS_THRESHOLD=10
OPS_DUPLICATE_SCANS_THRESHOLD=50
OPS_PENDING_RECONCILIATION_MINUTES=30
OPS_QUEUE_MAX_PENDING=100
OPS_QUEUE_MAX_WAIT_MINUTES=10
OPS_HEARTBEAT_MAX_AGE_MINUTES=3
